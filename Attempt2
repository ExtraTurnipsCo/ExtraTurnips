<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Austin & Jamie - Extra Turnips</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;1,400&family=DM+Sans:wght@300;400&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --text-primary: #1a1a18;
      --text-secondary: #5a5a56;
      --text-muted: #9a9a94;
      --bg: #faf9f7;
      --border: #e8e6e0;
      --accent: #2a2a26;
      --tag-bg: #f0ede6;
      --gold-light: #f5edd8;
      --gold-border: #d4a843;
      --gold-text: #7a5c1e;
    }

    html { font-size: 16px; }

    body {
      font-family: 'DM Sans', sans-serif;
      font-weight: 300;
      background: var(--bg);
      color: var(--text-primary);
      line-height: 1.7;
      min-height: 100vh;
    }

    .container {
      max-width: 640px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* NAV */
    nav {
      padding: 2rem 0 1.75rem;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-bottom: 1px solid var(--border);
      margin-bottom: 3rem;
    }

    .nav-logo {
      font-family: 'Lora', serif;
      font-size: 1.1rem;
      font-weight: 400;
      color: var(--text-primary);
      letter-spacing: -0.01em;
      cursor: pointer;
    }

    .nav-links {
      display: flex;
      gap: 1.75rem;
      list-style: none;
    }

    .nav-links a {
      font-size: 0.85rem;
      color: var(--text-muted);
      text-decoration: none;
      letter-spacing: 0.04em;
      cursor: pointer;
      transition: color 0.15s;
    }

    .nav-links a:hover,
    .nav-links a.active { color: var(--text-primary); }

    /* PAGES */
    .page { display: none; }
    .page.active { display: block; }

    /* HOME */
    .hero { margin-bottom: 3.5rem; }

    .hero h1 {
      font-family: 'Lora', serif;
      font-size: 2rem;
      font-weight: 400;
      line-height: 1.3;
      color: var(--text-primary);
      margin-bottom: 0.75rem;
      letter-spacing: -0.02em;
    }

    .hero p {
      font-size: 1rem;
      color: var(--text-secondary);
    }

    .section-label {
      font-size: 0.7rem;
      font-weight: 400;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
    }

    .post-list {
      display: flex;
      flex-direction: column;
    }

    .post-item {
      padding: 1.5rem 0;
      border-bottom: 1px solid var(--border);
      cursor: pointer;
    }

    .post-item:first-child { border-top: 1px solid var(--border); }
    .post-item:hover .post-title { color: var(--text-secondary); }

    .post-meta {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-bottom: 0.5rem;
      letter-spacing: 0.02em;
    }

    .post-title {
      font-family: 'Lora', serif;
      font-size: 1.2rem;
      font-weight: 400;
      line-height: 1.4;
      color: var(--text-primary);
      margin-bottom: 0.5rem;
      transition: color 0.15s;
    }

    .post-excerpt {
      font-size: 0.9rem;
      color: var(--text-secondary);
      line-height: 1.65;
    }

    .tag {
      display: inline-block;
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      background: var(--tag-bg);
      color: var(--text-muted);
      padding: 3px 10px;
      border-radius: 20px;
      margin-top: 0.75rem;
    }

    /* ABOUT */
    .about-section h2 {
      font-family: 'Lora', serif;
      font-size: 1.75rem;
      font-weight: 400;
      margin-bottom: 1.5rem;
      letter-spacing: -0.02em;
    }

    .about-section p {
      font-size: 1rem;
      color: var(--text-secondary);
      line-height: 1.8;
      margin-bottom: 1.1rem;
      max-width: 520px;
    }

    /* SINGLE POST */
    .post-full .back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.82rem;
      color: var(--text-muted);
      cursor: pointer;
      margin-bottom: 2rem;
      transition: color 0.15s;
      text-decoration: none;
      letter-spacing: 0.02em;
    }

    .post-full .back:hover { color: var(--text-primary); }

    .post-full .back svg {
      width: 14px; height: 14px;
      stroke: currentColor; fill: none;
      stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
    }

    .post-full h1 {
      font-family: 'Lora', serif;
      font-size: 1.85rem;
      font-weight: 400;
      line-height: 1.3;
      margin-bottom: 0.75rem;
      letter-spacing: -0.02em;
    }

    .post-full .post-meta {
      padding-bottom: 1.75rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 2rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .post-full p {
      font-size: 1rem;
      color: var(--text-secondary);
      line-height: 1.85;
      margin-bottom: 1.25rem;
    }

    .post-full p:last-child { margin-bottom: 0; }

    /* RATINGS PAGE */
    .ratings-header { margin-bottom: 2.5rem; }

    .ratings-header h1 {
      font-family: 'Lora', serif;
      font-size: 2rem;
      font-weight: 400;
      line-height: 1.3;
      letter-spacing: -0.02em;
      margin-bottom: 0.6rem;
    }

    .ratings-header p {
      font-size: 0.95rem;
      color: var(--text-secondary);
    }

    .filter-bar {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }

    .filter-label {
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-right: 0.25rem;
    }

    .filter-btn {
      font-family: 'DM Sans', sans-serif;
      font-size: 0.7rem;
      font-weight: 400;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 4px 12px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--text-muted);
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.15s;
    }

    .filter-btn:hover {
      color: var(--text-primary);
      border-color: var(--text-primary);
    }

    .filter-btn.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #faf9f7;
    }

    .rating-card {
      padding: 1.75rem 0;
      border-bottom: 1px solid var(--border);
    }

    .rating-card:first-of-type { border-top: 1px solid var(--border); }

    .rating-card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 0.35rem;
    }

    .rating-card-name {
      font-family: 'Lora', serif;
      font-size: 1.15rem;
      font-weight: 400;
      line-height: 1.3;
      color: var(--text-primary);
    }

    .rating-score {
      font-family: 'Lora', serif;
      font-size: 1.4rem;
      font-weight: 400;
      color: var(--text-primary);
      white-space: nowrap;
      line-height: 1;
    }

    .rating-score .denom {
      font-size: 0.72rem;
      color: var(--text-muted);
      font-family: 'DM Sans', sans-serif;
      font-weight: 300;
    }

    .rating-score.top-pick { color: var(--gold-text); }

    .rating-card-meta {
      font-size: 0.75rem;
      color: var(--text-muted);
      letter-spacing: 0.02em;
      margin-bottom: 0.75rem;
    }

    .rating-card-note {
      font-size: 0.9rem;
      color: var(--text-secondary);
      line-height: 1.75;
      margin-bottom: 1rem;
    }

    .rating-card-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 1.1rem;
    }

    .subscores { display: flex; flex-direction: column; gap: 0.5rem; }

    .subscore-row { display: flex; align-items: center; gap: 0.75rem; }

    .subscore-lbl {
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-muted);
      width: 5.5rem;
      flex-shrink: 0;
    }

    .subscore-track {
      flex: 1;
      height: 2px;
      background: var(--border);
      border-radius: 2px;
      overflow: hidden;
    }

    .subscore-fill {
      height: 100%;
      background: var(--accent);
      border-radius: 2px;
    }

    .subscore-val {
      font-size: 0.72rem;
      color: var(--text-secondary);
      width: 2rem;
      text-align: right;
      flex-shrink: 0;
    }

    .empty-state {
      padding: 3rem 0;
      font-size: 0.9rem;
      color: var(--text-muted);
      font-style: italic;
      display: none;
    }

    /* FOOTER */
    footer {
      margin-top: 4rem;
      padding: 1.75rem 0 2rem;
      border-top: 1px solid var(--border);
      font-size: 0.78rem;
      color: var(--text-muted);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    @media (max-width: 480px) {
      .hero h1 { font-size: 1.6rem; }
      .post-full h1 { font-size: 1.5rem; }
      .ratings-header h1 { font-size: 1.6rem; }
      footer { flex-direction: column; gap: 0.5rem; text-align: center; }
      .subscore-lbl { width: 4.5rem; }
    }
  </style>
</head>
<body>
  <div class="container">
    <nav>
      <span class="nav-logo" onclick="show('home')">Extra Turnips</span>
      <ul class="nav-links">
        <li><a id="nav-home" onclick="show('home')" class="active">Home</a></li>
        <li><a id="nav-about" onclick="show('about')">About</a></li>
        <li><a id="nav-ratings" onclick="show('ratings')">Ratings</a></li>
      </ul>
    </nav>

    <!-- HOME -->
    <div id="home" class="page active">
      <div class="hero">
        <h1>The Toronto Shawarma Scene.</h1>
        <p>We aren't just searching for the best shawarma. We're also trying to find places serving good authentic food that aren't getting as much attention as they deserve.</p>
      </div>

      <p class="section-label">Recent posts</p>

      <div class="post-list">
        <div class="post-item" onclick="show('post1')">
          <p class="post-meta">May 27, 2026 &middot; 4 min read</p>
          <p class="post-title">The Idea</p>
          <p class="post-excerpt">Whenever we had days off, we'd find ourselves in some random part of Toronto at a Shawarma place in a neighbourhood we'd never been to. So we figured we might as well create somewhere for people looking for new places in cool areas, centred around some of the best food in Toronto.</p>
          <span class="tag">Idea</span>
        </div>

        <div class="post-item" onclick="show('post2')">
          <p class="post-meta">2020–2026 &middot; 2 min read</p>
          <p class="post-title">The Old Tier System</p>
          <p class="post-excerpt">Here's a look at a few places we visited in the past, and the more casual ranking style.</p>
          <span class="tag">food</span>
        </div>

        <div class="post-item" onclick="show('post3')">
          <p class="post-meta">April 28, 2026 &middot; 5 min read</p>
          <p class="post-title">Notes from a week without social media</p>
          <p class="post-excerpt">What I noticed, what I missed, and whether I'd do it again.</p>
          <span class="tag">reflection</span>
        </div>

        <div class="post-item" onclick="show('post4')">
          <p class="post-meta">April 28, 2026 &middot; 5 min read</p>
          <p class="post-title">Notes from a week without social media</p>
          <p class="post-excerpt">What I noticed, what I missed, and whether I'd do it again.</p>
          <span class="tag">reflection</span>
        </div>
      </div>
    </div>

    <!-- ABOUT -->
    <div id="about" class="page">
      <div class="about-section">
        <h2>How We Got Started</h2>
        <p>We started getting shawarma in high school because it was convenient, but we quickly learnt that these places are often more than just food spots. They're run by such great people, often families that have built the business from scratch.</p>
        <p>For instance, I was in the west end at a place called Shadi Shawarma recently that we always used to go to after playing golf at Scarlett Woods in high school, a good 4–6 years ago. I walk in and the first thing the guy says is "I remember when you guys used to come in here after golf, how have you been".</p>
        <p>First off, I look a lot different than I did then. Second, I'm from Cabbagetown and this place is at Bloor and Runnymede. It's not like I'm passing by all the time. I genuinely don't know how he remembered me, but he did and that was pretty cool.</p>
        <p>Every interaction matters to these folks. That's why these places are special and that's probably why we keep going back. Not just because of the great food but because you always feel welcomed there.</p>
      </div>
    </div>

    <!-- RATINGS -->
    <div id="ratings" class="page">
      <div class="ratings-header">
        <h1>The Ratings.</h1>
        <p>Every place we've visited, scored out of 100. Taste counts for half.</p>
      </div>

      <div class="filter-bar">
        <span class="filter-label">Filter</span>
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="chicken">Chicken</button>
        <button class="filter-btn" data-filter="lamb">Lamb</button>
        <button class="filter-btn" data-filter="mixed">Mixed</button>
        <button class="filter-btn" data-filter="top">Top Picks</button>
      </div>

      <div id="ratingCards">

        <!-- CARD: Abou Hassan -->
        <div class="rating-card" data-type="mixed" data-score="95">
          <div class="rating-card-top">
            <span class="rating-card-name">Abou Hassan</span>
            <span class="rating-score top-pick">95 <span class="denom">/ 100</span></span>
          </div>
          <div class="rating-card-meta">Mississauga &middot; May 2025</div>
          <p class="rating-card-note">Our current number one. Meat that's been marinating since before you knew you were hungry, bread that tears cleanly. We've been back four times and it's never slipped.</p>
          <div class="rating-card-tags">
            <span class="tag">Mixed</span>
            <span class="tag">Wrap + Plate</span>
            <span class="tag">Must Visit</span>
          </div>
          <div class="subscores">
            <div class="subscore-row">
              <span class="subscore-lbl">Taste <span style="color:var(--border)">/50</span></span>
              <div class="subscore-track"><div class="subscore-fill" style="width:96%"></div></div>
              <span class="subscore-val">48</span>
            </div>
            <div class="subscore-row">
              <span class="subscore-lbl">Value <span style="color:var(--border)">/25</span></span>
              <div class="subscore-track"><div class="subscore-fill" style="width:92%"></div></div>
              <span class="subscore-val">23</span>
            </div>
            <div class="subscore-row">
              <span class="subscore-lbl">Experience <span style="color:var(--border)">/25</span></span>
              <div class="subscore-track"><div class="subscore-fill" style="width:96%"></div></div>
              <span class="subscore-val">24</span>
            </div>
          </div>
        </div>

        <!-- CARD: Al Salam -->
        <div class="rating-card" data-type="mixed" data-score="88">
          <div class="rating-card-top">
            <span class="rating-card-name">Al Salam Shawarma</span>
            <span class="rating-score top-pick">88 <span class="denom">/ 100</span></span>
          </div>
          <div class="rating-card-meta">Little Lebanon, Toronto &middot; Mar 2025</div>
          <p class="rating-card-note">The mixed plate is revelatory — beef and lamb rotating together, carved to order. Their toum is almost aggressively garlicky, which is exactly the point.</p>
          <div class="rating-card-tags">
            <span class="tag">Mixed</span>
            <span class="tag">Wrap + Plate</span>
            <span class="tag">Late Night</span>
          </div>
          <div class="subscores">
            <div class="subscore-row">
              <span class="subscore-lbl">Taste <span style="color:var(--border)">/50</span></span>
              <div class="subscore-track"><div class="subscore-fill" style="width:90%"></div></div>
              <span class="subscore-val">45</span>
            </div>
            <div class="subscore-row">
              <span class="subscore-lbl">Value <span style="color:var(--border)">/25</span></span>
              <div class="subscore-track"><div class="subscore-fill" style="width:84%"></div></div>
              <span class="subscore-val">21</span>
            </div>
            <div class="subscore-row">
              <span class="subscore-lbl">Experience <span style="color:var(--border)">/25</span></span>
              <div class="subscore-track"><div class="subscore-fill" style="width:88%"></div></div>
              <span class="subscore-val">22</span>
            </div>
          </div>
        </div>

        <!-- CARD: Farouk's -->
        <div class="rating-card" data-type="chicken" data-score="84">
          <div class="rating-card-top">
            <span class="rating-card-name">Farouk's on Danforth</span>
            <span class="rating-score top-pick">84 <span class="denom">/ 100</span></span>
          </div>
          <div class="rating-card-meta">Greektown, Toronto &middot; Jan 2025</div>
          <p class="rating-card-note">Best chicken shawarma in the east end. The marinade has a citrus-forward depth you don't often find. Bread is fresh and pillowy — they clearly bake in-house.</p>
          <div class="rating-card-tags">
            <span class="tag">Chicken</span>
            <span class="tag">Wrap Only</span>
          </div>
          <div class="subscores">
            <div class="subscore-row">
              <span class="subscore-lbl">Taste <span style="color:var(--border)">/50</span></span>
              <div class="subscore-track"><div class="subscore-fill" style="width:88%"></div></div>
              <span class="subscore-val">44</span>
            </div>
            <div class="subscore-row">
              <span class="subscore-lbl">Value <span style="color:var(--border)">/25</span></span>
              <div class="subscore-track"><div class="subscore-fill" style="width:80%"></div></div>
              <span class="subscore-val">20</span>
            </div>
            <div class="subscore-row">
              <span class="subscore-lbl">Experience <span style="color:var(--border)">/25</span></span>
              <div class="subscore-track"><div class="subscore-fill" style="width:80%"></div></div>
              <span class="subscore-val">20</span>
            </div>
          </div>
        </div>

        <!-- CARD: Golden Spit -->
        <div class="rating-card" data-type="chicken" data-score="81">
          <div class="rating-card-top">
            <span class="rating-card-name">Golden Spit</span>
            <span class="rating-score">81 <span class="denom">/ 100</span></span>
          </div>
          <div class="rating-card-meta">Scarborough &middot; Feb 2025</div>
          <p class="rating-card-note">Incredibly consistent, week after week. The chicken is never dry, never under-spiced. Pickled vegetables are excellent and the toum has just the right bite.</p>
          <div class="rating-card-tags">
            <span class="tag">Chicken</span>
            <span class="tag">Family-Run</span>
          </div>
          <div class="subscores">
            <div class="subscore-row">
              <span class="subscore-lbl">Taste <span style="color:var(--border)">/50</span></span>
              <div class="subscore-track"><div class="subscore-fill" style="width:84%"></div></div>
              <span class="subscore-val">42</span>
            </div>
            <div class="subscore-row">
              <span class="subscore-lbl">Value <span style="color:var(--border)">/25</span></span>
              <div class="subscore-track"><div class="subscore-fill" style="width:76%"></div></div>
              <span class="subscore-val">19</span>
            </div>
            <div class="subscore-row">
              <span class="subscore-lbl">Experience <span style="color:var(--border)">/25</span></span>
              <div class="subscore-track"><div class="subscore-fill" style="width:80%"></div></div>
              <span class="subscore-val">20</span>
            </div>
          </div>
        </div>

        <!-- CARD: Beirut House -->
        <div class="rating-card" data-type="lamb" data-score="78">
          <div class="rating-card-top">
            <span class="rating-card-name">Beirut House</span>
            <span class="rating-score">78 <span class="denom">/ 100</span></span>
          </div>
          <div class="rating-card-meta">North York, Toronto &middot; Feb 2025</div>
          <p class="rating-card-note">Exceptional lamb, properly fatty and charred at the edges. The pickled turnips — our namesake — are electric. Bread is fine, nothing more.</p>
          <div class="rating-card-tags">
            <span class="tag">Lamb</span>
            <span class="tag">Plate Available</span>
            <span class="tag">Turnip Forward</span>
          </div>
          <div class="subscores">
            <div class="subscore-row">
              <span class="subscore-lbl">Taste <span style="color:var(--border)">/50</span></span>
              <div class="subscore-track"><div class="subscore-fill" style="width:84%"></div></div>
              <span class="subscore-val">42</span>
            </div>
            <div class="subscore-row">
              <span class="subscore-lbl">Value <span style="color:var(--border)">/25</span></span>
              <div class="subscore-track"><div class="subscore-fill" style="width:72%"></div></div>
              <span class="subscore-val">18</span>
            </div>
            <div class="subscore-row">
              <span class="subscore-lbl">Experience <span style="color:var(--border)">/25</span></span>
              <div class="subscore-track"><div class="subscore-fill" style="width:72%"></div></div>
              <span class="subscore-val">18</span>
            </div>
          </div>
        </div>

        <!-- CARD: The Spit & Wrap Co. -->
        <div class="rating-card" data-type="chicken" data-score="68">
          <div class="rating-card-top">
            <span class="rating-card-name">The Spit & Wrap Co.</span>
            <span class="rating-score">68 <span class="denom">/ 100</span></span>
          </div>
          <div class="rating-card-meta">Kensington Market, Toronto &middot; Apr 2025</div>
          <p class="rating-card-note">A bit of a tourist trap. The chicken is fine — competent, seasoned well — but nothing you'd travel for. They lean on portions over craft. Loud and fun though.</p>
          <div class="rating-card-tags">
            <span class="tag">Chicken</span>
            <span class="tag">Counter Service</span>
          </div>
          <div class="subscores">
            <div class="subscore-row">
